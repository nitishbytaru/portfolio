# Server-only settings for the /admin area. Never prefix these with NEXT_PUBLIC_.
# The public site builds without any of them.

# GitHub OAuth app (callback: https://<your-domain>/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Fine-grained token: this repo only, Contents read and write
GITHUB_CONTENT_TOKEN=
GITHUB_REPO=owner/portfolio
# Use a test branch for local work
CONTENT_BRANCH=main

# Your numeric GitHub user id (https://api.github.com/users/<username>)
ADMIN_GITHUB_ID=

# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=