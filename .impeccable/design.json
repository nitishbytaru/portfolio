  "narrative": {
    "northStar": "The Framed Color Board",
    "overview": "Every page is one near-white sheet lifted off a pale gray page, and on that sheet sits a packed arrangement of flat, saturated tiles. A tile is the unit of everything: an introduction, a count, a screenshot, a skill, a route. Real screenshots share the board with color fields at the same radius, so proof and decoration read as one surface.\n\nThe voice is loud at the top and plain underneath. A giant expanded Archivo wordmark names each page and carries a small corner bracket; below it, tiles do the talking in heavy expanded headings and ordinary-width body copy. The board stays dense. Tiles sit a narrow gutter apart, and color alone separates them.\n\nThe world is pinned by the owner's reference, `ref/image.png`, and runs on one fixed light theme.",
    "keyCharacteristics": [
      "A single rounded sheet framed by a gray page on desktop, full-bleed on small screens.",
      "Flat color tiles with one shared radius and no tile shadows.",
      "One typeface in two widths: expanded for display, normal for reading.",
      "Small corner brackets and rotated side labels as the recurring marks.",
      "Real screenshots and real counts inside the tile grid."
    ],
    "rules": [
      {
        "name": "The Ink On Color Rule",
        "body": "Text on periwinkle, pink, mint, violet and amber defaults to Ink. Text on graphite and black is white.",
        "section": "colors"
      },
      {
        "name": "The Large White Rule",
        "body": "White on periwinkle (3.51:1) or violet (4.08:1) is reserved for display sizes, 30px and up. Reading copy on those fields stays Ink.",
        "section": "colors"
      },
      {
        "name": "The Rotating Tones Rule",
        "body": "Repeated tiles cycle through the tone set, so neighbors differ. No single hue owns a page's content grid.",
        "section": "colors"
      },
      {
        "name": "The Width Means Display Rule",
        "body": "Expanded width belongs to wordmarks, headings, numerals and route names. Paragraphs, lists, chips and metadata stay at normal width, apart from the short label under a Home count.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Text is set in sentence case with default tracking. The Spin Badge's circular text is the one uppercase setting.",
        "section": "typography"
      },
      {
        "name": "The Flat Tile Rule",
        "body": "Tiles carry no shadow at rest or on hover. Hover response is a lift in position or a change in brightness.",
        "section": "elevation"
      },
      {
        "name": "The Seamless Split Rule",
        "body": "Two fields that belong together share one 20px clipped container with square inner edges and no gutter between them.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do open every page with one Wordmark and its bracket, then go straight into the tile grid.",
      "Do build new content from Tile tones, at the 20px radius with 16px to 20px gutters.",
      "Do use real screenshots and real counts inside tiles.",
      "Do vary tile spans and rotate tones so a page reads as a composed board.",
      "Do keep tap targets at 44px minimum and retain the global focus ring.",
      "Do respect reduced motion; the global rule removes animation and shortens transitions."
    ],
    "donts": [
      "Don't add a dark theme or theme switch; the world is one fixed light theme.",
      "Don't put shadows on tiles; shadows belong to the sheet and the mobile popover.",
      "Don't introduce a second typeface; width and weight within Archivo carry the hierarchy.",
      "Don't set reading copy in white on periwinkle or violet.",
      "Don't add a page-level dark hero, stats row or uniform card grid; the board replaced them.",
      "Don't invent counts, clients or awards to fill a tile."
    ]
  }
}
